# Скопіювати в .env.production і заповнити значеннями з Firebase Console →
# Project settings → Your apps → Web app. Ці ключі публічні (не секрет),
# захист даних забезпечують Security Rules.
VITE_USE_EMULATORS=false
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_APP_ID=
# Sentry (помилки на сайті), див. docs/monitoring.md. Порожньо — вимкнено.
VITE_SENTRY_DSN=
# Хто бачить адмінку (через кому); має збігатися зі списком у firestore.rules і storage.rules.
VITE_SELLER_EMAILS=
# Плашка «Магазин ще в розробці» над шапкою (true — показувати).
VITE_UNDER_CONSTRUCTION=false
