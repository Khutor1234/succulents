rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {
    // Фото товарів (products) і заставки статей блогу (blog): дивляться всі, завантажує лише продавець.
    // Список email-ів має збігатися з firestore.rules, VITE_SELLER_EMAILS і functions/.env.<project>.
    match /{folder}/{allPaths=**} {
      allow read: if folder in ['products', 'blog'];
      allow write: if folder in ['products', 'blog']
        && request.auth != null
        && (request.auth.token.role == 'seller'
            || (request.auth.token.email_verified == true
                && request.auth.token.email in ['khutornaalexandra@gmail.com']))
        && request.resource.size < 5 * 1024 * 1024
        && request.resource.contentType.matches('image/.*');
    }
  }
}
